# ── Сборка и окружения ──────────────────────────────────────────────────
main.spec
build
dist
venv
.venv
__pycache__
*.pyc
.pytest_cache

# ── Пользовательские данные ─────────────────────────────────────────────
# Здесь лежат приватные ключи, мнемоники, токены и пароли.
# Игнорируем каталог целиком: всё в нём создаётся во время работы.
data/*
!data/.gitkeep

# ── Конфиги с учётными данными ──────────────────────────────────────────
config/cex_settings.py
config/modules/cfg_pinterest.py

# ── Результаты работы, логи, бэкапы, базы ───────────────────────────────
result/*
log/*
backups/*
db/*
!db/version

# ── ОС и редакторы ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/

# ── Инструменты ─────────────────────────────────────────────────────────
.claude
.playwright-mcp
.github
scripts

# ── Артефакты обфускации PyArmor (оригиналы без защиты) ────────────────
*.backup
modules/statistics/astrum_captcha_solver.py.original

